ANTHROPIC_API_KEY=sk-ant-...
# Modelo (opus es el más preciso con letra difícil; puedes probar claude-sonnet-5-5 para ahorrar)
MODEL=claude-opus-5-5

# WhatsApp Cloud API (Meta)
WA_TOKEN=EAAG...            # token permanente de usuario del sistema
WA_PHONE_NUMBER_ID=123456789
WA_VERIFY_TOKEN=inventa-un-texto-secreto
WA_APP_SECRET=...           # App Secret de tu app de Meta (valida que el mensaje sí viene de Meta)

# Números autorizados a usar el bot, con lada país, sin +, separados por coma
ALLOWED_NUMBERS=5215512345678
